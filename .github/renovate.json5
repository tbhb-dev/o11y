{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The repository-level policy comes from the shared devtools preset:
  // its rules, grouping, and the custom managers for pin sites no built-in
  // manager reads. It's pinned to a commit, and the trailing version
  // comment is what devtools:check-pins and devtools:update-pins read.
  //
  // The global-only options (identity, limits, requireConfig) are inlined
  // here rather than taken from globalExtends, which Renovate resolves
  // before host rules exist, so that fetch would run unauthenticated.
  requireConfig: "ignored",
  username: "tbhb-dev-renovate[bot]",
  gitAuthor: "tbhb-dev-renovate[bot] <289255489+tbhb-dev-renovate[bot]@users.noreply.github.com>",
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  extends: [
    "github>tbhb-dev/devtools//.github/renovate-config.json5#902790ab90cb5e018d22c54ea4bb12711f632253", // v0.11.0
  ],

  packageRules: [
    // The stack's images move together, tag and index digest as a pair,
    // so one pull request shows what a set of upgrades does to the boot
    // test. The shared preset pins digests for GitHub Actions only.
    {
      matchManagers: ["docker-compose"],
      pinDigests: true,
      groupName: "o11y-stack",
    },
    // RustFS holds every backend's data and is young, so an upgrade is a
    // decision of its own: a separate pull request, never merged by itself.
    {
      matchManagers: ["docker-compose"],
      matchPackageNames: ["rustfs/rustfs"],
      groupName: "rustfs",
      automerge: false,
    },
  ],

  repositories: ["tbhb-dev/o11y"],
}
