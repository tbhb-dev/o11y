# Copy to mise.local.toml, fill in, and never commit the copy. The values
# below are placeholders only; real host names, addresses and paths belong
# in the gitignored mise.local.toml. tools/check-leaks.sh reads the real
# values from there and fails a commit or push that carries one.
[env]
O11Y_SSH_HOST = "nas.example.invalid"
O11Y_REMOTE_DIR = "/srv/o11y"
O11Y_REMOTE_DOCKER = "/usr/bin/docker"
O11Y_REMOTE_COMPOSE = "/usr/bin/docker-compose"
O11Y_REMOTE_TAILSCALE = "/usr/bin/tailscale"
O11Y_TAILNET_DOMAIN = "example.ts.net"
O11Y_NODE_ADDR = "192.0.2.10"
# Comma-separated extra strings to keep out of the repository, such as other
# host names or a model identifier. May be empty.
O11Y_PRIVATE_STRINGS = ""
# The cluster label on the stack's self-metrics. Leave it unset for the
# default, o11y; a site name set here is private and the leak check treats it
# that way.
# O11Y_CLUSTER = ""
# GiB that preflight, gate-test and deploy require free under O11Y_REMOTE_DIR,
# on top of 10 percent of the filesystem. Not private.
# O11Y_DISK_RESERVE_GB = "50"
# The 1Password secret reference whose value is the Discord webhook URL for
# alerts, in the form `op read` takes. deploy pipes the URL from `op read`
# to the host, so it never sits in a file or variable here. Private: the leak
# check treats the reference and its item name that way.
O11Y_ALERT_DISCORD_WEBHOOK_REF = ""
# Email alerts, off while O11Y_ALERT_EMAIL_TO is empty. With a recipient,
# the SMTP host, port, login and sender must be set too, and deploy pipes the
# SMTP password from `op read` of O11Y_ALERT_SMTP_PASSWORD_REF to the host.
# Grafana requires STARTTLS. The addresses, the login and the reference are
# private, and the leak check treats them that way.
O11Y_ALERT_EMAIL_TO = ""
# O11Y_ALERT_SMTP_HOST = "smtp.example.invalid"
# O11Y_ALERT_SMTP_PORT = "587"
# O11Y_ALERT_SMTP_USER = "alerts@example.invalid"
# O11Y_ALERT_SMTP_FROM = "alerts@example.invalid"
# O11Y_ALERT_SMTP_PASSWORD_REF = ""
