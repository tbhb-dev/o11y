# Copy to mise.local.toml, fill in, and never commit the copy. The values
# below are placeholders only; real hostnames, addresses and 1Password
# references belong in the gitignored mise.local.toml.
[env]
NAS_SSH_HOST = "nas.example.invalid"
NAS_SSH_USER = "deploy"
NAS_DEPLOY_DIR = "/path/to/deploy/dir"
GRAFANA_ADMIN_PASSWORD_REF = "op://VAULT/ITEM/FIELD"
