{
  "uid": "o11y-stack-health",
  "title": "Stack health",
  "description": "The stack's own services, scraped by Alloy as o11y/<component>. Missing, stale or failed data reads as Unavailable, Down or Stale, never as healthy. Up means the scrape succeeded, not that telemetry was delivered.",
  "tags": ["o11y"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "title": "Up: o11y/alloy",
      "description": "The last scrape succeeded. Unavailable when the newest sample is 90 seconds old or more, or there is none.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "Unavailable",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"o11y/alloy\"} and time() - timestamp(up{job=\"o11y/alloy\"}) < 90",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        }
      ],
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      }
    },
