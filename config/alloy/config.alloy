// The only ingestion path. OTLP arrives on 4317 (gRPC) and 4318 (HTTP) and
// fans out by signal: traces to Tempo, logs to Loki, metrics to Mimir.

otelcol.receiver.otlp "default" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		metrics = [otelcol.processor.memory_limiter.default.input]
		logs    = [otelcol.processor.memory_limiter.default.input]
		traces  = [otelcol.processor.memory_limiter.default.input]
	}
}

otelcol.processor.memory_limiter "default" {
	check_interval = "1s"
	limit          = "384MiB"

	output {
		metrics = [otelcol.processor.transform.resource.input]
		logs    = [otelcol.processor.transform.resource.input]
		traces  = [otelcol.processor.transform.resource.input]
	}
}

// Loki indexes deployment.environment.name as a label. Older SDKs send
// deployment.environment, so copy it across when the new name is absent.
otelcol.processor.transform "resource" {
	error_mode = "ignore"

	trace_statements {
		context    = "resource"
		statements = [`set(attributes["deployment.environment.name"], attributes["deployment.environment"]) where attributes["deployment.environment.name"] == nil and attributes["deployment.environment"] != nil`]
	}

	metric_statements {
		context    = "resource"
		statements = [`set(attributes["deployment.environment.name"], attributes["deployment.environment"]) where attributes["deployment.environment.name"] == nil and attributes["deployment.environment"] != nil`]
	}

	log_statements {
		context    = "resource"
		statements = [`set(attributes["deployment.environment.name"], attributes["deployment.environment"]) where attributes["deployment.environment.name"] == nil and attributes["deployment.environment"] != nil`]
	}

	output {
		metrics = [otelcol.processor.batch.default.input]
		logs    = [otelcol.processor.batch.default.input]
		traces  = [otelcol.processor.batch.default.input]
	}
}

otelcol.processor.batch "default" {
	timeout         = "5s"
	send_batch_size = 2000

	output {
		metrics = [otelcol.exporter.otlphttp.mimir.input]
		logs    = [otelcol.exporter.otlphttp.loki.input]
		traces  = [otelcol.exporter.otlp.tempo.input]
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo:4317"

		tls {
			insecure = true
		}
	}
}

otelcol.exporter.otlphttp "loki" {
	client {
		endpoint = "http://loki:3100/otlp"
	}
}

otelcol.exporter.otlphttp "mimir" {
	client {
		endpoint = "http://mimir:8080/otlp"
	}
}

// Self-monitoring: one scrape per service of the stack, so each gets its own
// limits. A scrape over any of them fails whole and sets up to 0, so the job
// reads as down rather than as healthy. Jobs follow the Mimir mixin's
// <namespace>/<component> shape.
// Each sample_limit is the most samples one scrape returned on a local
// stack under telemetrygen at 50 items a second per signal (alloy 1282,
// grafana 4676, loki 2185, mimir 3665, tempo 1051), at least doubled and
// rounded up to the next thousand. Going over drops the whole scrape and
// shows the job as down, and Grafana's and Mimir's series grow as
// dashboards and clients are added, so the margin is wide. The Stack
// health dashboard shows each against its limit.
prometheus.scrape "alloy" {
	targets         = [{"__address__" = "alloy:12345", "job" = "o11y/alloy"}]
	scrape_interval = "30s"
	sample_limit    = 3000
	label_limit     = 40
	body_size_limit = "16MiB"
	forward_to      = [prometheus.relabel.stack.receiver]
}

prometheus.scrape "loki" {
	targets         = [{"__address__" = "loki:3100", "job" = "o11y/loki"}]
	scrape_interval = "30s"
	sample_limit    = 5000
	label_limit     = 40
	body_size_limit = "16MiB"
	forward_to      = [prometheus.relabel.stack.receiver]
}

prometheus.scrape "tempo" {
	targets         = [{"__address__" = "tempo:3200", "job" = "o11y/tempo"}]
	scrape_interval = "30s"
	sample_limit    = 3000
	label_limit     = 40
	body_size_limit = "16MiB"
	forward_to      = [prometheus.relabel.stack.receiver]
}

prometheus.scrape "mimir" {
	targets         = [{"__address__" = "mimir:8080", "job" = "o11y/mimir"}]
	scrape_interval = "30s"
	sample_limit    = 8000
	label_limit     = 40
	body_size_limit = "16MiB"
	forward_to      = [prometheus.relabel.stack.receiver]
}

prometheus.scrape "grafana" {
	targets         = [{"__address__" = "grafana:3000", "job" = "o11y/grafana"}]
	scrape_interval = "30s"
	sample_limit    = 10000
	label_limit     = 40
	body_size_limit = "16MiB"
	forward_to      = [prometheus.relabel.stack.receiver]
}

// cluster comes from the release's O11Y_CLUSTER, o11y unless the owner names
// a site.
prometheus.relabel "stack" {
	rule {
		target_label = "cluster"
		replacement  = sys.env("O11Y_CLUSTER")
	}

	rule {
		target_label = "namespace"
		replacement  = "o11y"
	}
	forward_to = [prometheus.remote_write.mimir.receiver]
}

// Bounded: at most 4 shards of 5000 queued samples, and a WAL that keeps a
// series no longer than about 2.5 hours while Mimir is unreachable.
prometheus.remote_write "mimir" {
	endpoint {
		url = "http://mimir:8080/api/v1/push"

		queue_config {
			capacity             = 5000
			max_shards           = 4
			max_samples_per_send = 2000
		}
	}

	wal {
		max_keepalive_time = "2h"
		truncate_frequency = "30m"
	}
}

// The stack's own OTLP metrics, from RustFS, which serves no Prometheus
// endpoint. HTTP on 4320 only and never published, so only the stack's own
// network reaches it. Its memory limiter sits below the client one, so the
// self path refuses first, and its exporter has a queue of its own, bounded
// in items, so a backlog here fills that queue rather than the client ones.
otelcol.receiver.otlp "self" {
	http {
		endpoint = "0.0.0.0:4320"
	}

	output {
		metrics = [otelcol.processor.memory_limiter.self.input]
	}
}

otelcol.processor.memory_limiter "self" {
	check_interval = "1s"
	limit          = "320MiB"

	output {
		metrics = [otelcol.processor.filter.self.input]
	}
}

// An allowlist of metric names: start, readiness, process memory, HTTP and
// S3 traffic and failures, capacity, and drive health and errors. RustFS
// 1.0.1 sends about 2000 series on an idle stack. Dropping attributes
// without aggregating would collide datapoint identities, so this bounds
// the series by name only, and the dashboard shows their count.
otelcol.processor.filter "self" {
	error_mode = "ignore"

	metrics {
		metric = [`not IsMatch(name, "^(` + string.join([
			"rustfs_start_total",
			"rustfs_runtime_readiness_ready",
			"rustfs_system_process_start_time_seconds",
			"rustfs_system_process_resident_memory_bytes",
			"rustfs_http_server_requests_total",
			"rustfs_http_server_failures_total",
			"rustfs_http_server_request_duration_seconds",
			"rustfs_s3_operations_total",
			"rustfs_cluster_capacity_usable_total_bytes",
			"rustfs_cluster_capacity_free_bytes",
			"rustfs_cluster_health_drives_online",
			"rustfs_cluster_health_drives_offline",
			"rustfs_system_drive_availability_errors_total",
			"rustfs_system_drive_timeout_errors_total",
		], "|") + `)$")`]
	}

	output {
		metrics = [otelcol.processor.transform.self.input]
	}
}

// Identity: job o11y/rustfs, instance rustfs:9000, and the host and
// environment from the release, whatever RustFS reports. RustFS's node
// identity and local address are dropped. namespace and cluster also go on
// each datapoint, so the series carry them as labels.
otelcol.processor.transform "self" {
	error_mode = "ignore"

	metric_statements {
		context    = "resource"
		statements = [
			`set(attributes["service.namespace"], "o11y")`,
			`set(attributes["service.instance.id"], "rustfs:9000")`,
			`delete_key(attributes, "network.local.address")`,
			`delete_key(attributes, "rustfs.node")`,
			string.format(`set(attributes["host.name"], %q)`, sys.env("O11Y_HOST_NAME")),
			string.format(`set(attributes["deployment.environment.name"], %q)`, sys.env("O11Y_ENVIRONMENT")),
		]
	}

	metric_statements {
		context    = "datapoint"
		statements = [
			`set(attributes["namespace"], "o11y")`,
			string.format(`set(attributes["cluster"], %q)`, sys.env("O11Y_CLUSTER")),
		]
	}

	output {
		metrics = [otelcol.processor.batch.self.input]
	}
}

otelcol.processor.batch "self" {
	timeout             = "5s"
	send_batch_size     = 1000
	send_batch_max_size = 2000

	output {
		metrics = [otelcol.exporter.otlphttp.mimir_self.input]
	}
}

otelcol.exporter.otlphttp "mimir_self" {
	client {
		endpoint = "http://mimir:8080/otlp"
	}

	sending_queue {
		sizer      = "items"
		queue_size = 20000
	}
}
